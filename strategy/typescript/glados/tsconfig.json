{
    "compilerOptions": {
        "allowUnreachableCode": false,
		"module": "AMD",
		"lib": ["ESNext", "ES2018", "ES2017", "ES2016", "ES2015"],
		"moduleResolution": "node",
		"noImplicitAny": true,
		"noImplicitReturns": true,
		"noFallthroughCasesInSwitch": true,
		"preserveConstEnums": true,
		"pretty": true,
		"removeComments": true,
		"sourceMap": true,
		"strictNullChecks": true,
		"strict": true,
		"target": "esnext",
		"outDir": "built",
		"baseUrl": ".."
    },
    "files": [
        "init.ts"
    ]
}
